{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/:f(\\.env.*)",
      "destination": "/api/online?a=trap&p=:f"
    },
    {
      "source": "/:f(\\.git.*)",
      "destination": "/api/online?a=trap&p=:f"
    },
    {
      "source": "/:f(\\.aws.*)",
      "destination": "/api/online?a=trap&p=:f"
    },
    {
      "source": "/:f(\\.ssh.*)",
      "destination": "/api/online?a=trap&p=:f"
    },
    {
      "source": "/:f(\\.svn.*)",
      "destination": "/api/online?a=trap&p=:f"
    },
    {
      "source": "/:f(\\.hg.*)",
      "destination": "/api/online?a=trap&p=:f"
    },
    {
      "source": "/:f(\\.docker.*)",
      "destination": "/api/online?a=trap&p=:f"
    },
    {
      "source": "/:f(\\.vscode.*)",
      "destination": "/api/online?a=trap&p=:f"
    },
    {
      "source": "/:f(\\.idea.*)",
      "destination": "/api/online?a=trap&p=:f"
    },
    {
      "source": "/:f(\\.npmrc.*)",
      "destination": "/api/online?a=trap&p=:f"
    },
    {
      "source": "/:f(\\.htaccess.*)",
      "destination": "/api/online?a=trap&p=:f"
    },
    {
      "source": "/:f(\\.htpasswd.*)",
      "destination": "/api/online?a=trap&p=:f"
    },
    {
      "source": "/:f(\\.DS_Store.*)",
      "destination": "/api/online?a=trap&p=:f"
    },
    {
      "source": "/:f(\\.anthropic.*)",
      "destination": "/api/online?a=trap&p=:f"
    },
    {
      "source": "/:f(\\.kube.*)",
      "destination": "/api/online?a=trap&p=:f"
    },
    {
      "source": "/:f(\\.terraform.*)",
      "destination": "/api/online?a=trap&p=:f"
    },
    {
      "source": "/:f(\\.circleci.*)",
      "destination": "/api/online?a=trap&p=:f"
    },
